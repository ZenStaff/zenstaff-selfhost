# Used only with the "https" profile (COMPOSE_PROFILES=https). Caddy gets and renews the
# certificates by itself; both names must point at this server and ports 80/443 must be open.
{$HUB_DOMAIN} {
	encode zstd gzip
	reverse_proxy hub:8787 {
		# The hub reads the visitor's address from this header (HUB_CLIENT_IP_HEADER=x-real-ip).
		header_up X-Real-IP {remote_host}
	}
}

{$MEMORY_DOMAIN} {
	encode zstd gzip
	# Only the app API is public; the admin API stays on the internal network (the hub uses it).
	@api path /v1/* /healthz
	handle @api {
		reverse_proxy memory:8000
	}
	handle {
		respond 404
	}
}

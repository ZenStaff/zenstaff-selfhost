# =================================================================================================
# Zen Staff self-host settings. Copy to .env, then run scripts/gen-secrets.sh to fill the secrets:
#   cp .env.example .env && scripts/gen-secrets.sh
# Lines marked REQUIRED must have a value before `docker compose up`. Everything else has a
# working default. Keep .env private (chmod 600); never commit it.
# =================================================================================================

# --- Addresses -------------------------------------------------------------------------------------
# REQUIRED. The address people and the Zen Staff app use to reach the hub (links in e-mails, passkeys).
# Use https in production. http works only on localhost (the app refuses plain http elsewhere).
HUB_PUBLIC_URL=https://hub.example.com
# The address the Zen Staff apps use to reach company memory (must be https outside localhost).
# Empty = company memory is off (the hub works without it).
MEMORY_PUBLIC_URL=https://memory.example.com

# Where the containers listen on this machine. Keep 127.0.0.1 and put HTTPS in front: either the
# bundled Caddy (COMPOSE_PROFILES=https below) or your own reverse proxy (nginx, Traefik, ...).
HUB_BIND=127.0.0.1
HUB_PORT=8787
MEMORY_BIND=127.0.0.1
MEMORY_PORT=8740

# Optional profiles, comma-separated: "https" (Caddy with automatic certificates) and/or
# "local-embedder" (embeddings on this machine, see "Embeddings" below).
COMPOSE_PROFILES=local-embedder
# With the "https" profile: the two host names (DNS must point at this server, ports 80 and 443
# open). Set HUB_CLIENT_IP_HEADER=x-real-ip as well.
HUB_DOMAIN=hub.example.com
MEMORY_DOMAIN=memory.example.com

# --- Secrets (scripts/gen-secrets.sh fills these) --------------------------------------------------
# REQUIRED. 32 random bytes, base64: encrypts two-factor secrets at rest. Keep a copy in your password
# manager; without it the two-factor secrets in a restored backup cannot be read.
HUB_SECRET_KEY=
# REQUIRED. Shared between the hub and the memory API (the hub creates one memory space per company
# and issues per-machine keys through it). Never exposed: the admin API is on the internal network.
MEMORY_ADMIN_TOKEN=
# REQUIRED. Password of the internal Neo4j database.
NEO4J_PASSWORD=
# REQUIRED (with ENCRYPTION=required). Master key(s) that wrap each company's data key, as
# "<id>:<base64 32 bytes>", comma-separated; ZM_MASTER_KEY_ID picks the one used for new keys.
# Keep a copy OUTSIDE this server and outside the backups.
ZM_MASTER_KEYS=
ZM_MASTER_KEY_ID=
# required = refuse to start without ZM_MASTER_KEYS; auto = encrypt only when it is set.
ENCRYPTION=required

# --- First admin -----------------------------------------------------------------------------------
# Comma-separated e-mails of the hub's operators: they open the admin pages (/app/admin). Anyone can
# sign in and create a company; put your own address here.
HUB_ADMIN_EMAILS=

# --- E-mail (sign-in codes and invitations) --------------------------------------------------------
# Pick one: Resend (RESEND_API_KEY) or any SMTP server (HUB_SMTP_HOST). With neither, e-mails are not
# sent and every sign-in code is written to the hub's log: `docker compose logs hub | grep code`.
HUB_MAIL_FROM=Zen Staff <no-reply@example.com>
RESEND_API_KEY=
# SMTP (used only when RESEND_API_KEY is empty): your mail server, Microsoft 365, Google Workspace,
# Amazon SES, Mailgun, ... Port defaults to 587 (STARTTLS, required) or 465 with HUB_SMTP_SECURE=1.
HUB_SMTP_HOST=
HUB_SMTP_PORT=
# 1 = implicit TLS (port 465).
HUB_SMTP_SECURE=
# Both or neither.
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=
# 1 = allow sending without TLS (only for a relay on your own network).
HUB_SMTP_ALLOW_PLAIN=

# --- AI for company memory -------------------------------------------------------------------------
# Memory reads one summary per finished conversation and extracts facts, decisions and promises with
# a small model. Your key, your bill: about $0.005 per summary with the default model.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
# Prompt caching of the fixed instructions (cheaper) and how long the cache lives.
LLM_PROMPT_CACHE=on
LLM_CACHE_TTL=1h
# Message Batches: 50% cheaper, but memory then lags minutes to hours behind. Leave off.
LLM_BATCH=off
# A different model for one step only, e.g. zm.review=claude-sonnet-5-5. Empty = LLM_MODEL everywhere.
LLM_STEP_MODELS=
# Prices per million tokens, used only for the cost estimate in the usage report.
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.50

# --- Embeddings (search vectors) -------------------------------------------------------------------
# Option A (default): local, no per-call cost, ~3.5 GB RAM. Keep "local-embedder" in COMPOSE_PROFILES
# and these values.
EMBEDDER_PROVIDER=openai
EMBEDDER_URL=http://embedder:80/v1
EMBEDDER_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDER_API_KEY=none
EMBEDDING_DIM=1024
EMBEDDER_QUERY_INSTRUCTION="Instruct: Given a question about a company's business history, retrieve the facts that answer it\nQuery: "
# Option B: any OpenAI-compatible /v1/embeddings service. Remove "local-embedder" from
# COMPOSE_PROFILES and set EMBEDDER_URL (e.g. https://api.openai.com/v1), EMBEDDER_API_KEY,
# EMBEDDER_MODEL (e.g. text-embedding-3-small) and EMBEDDING_DIM (1536 for that model).
# Option C: the same Qwen3 model on Cloudflare Workers AI (identical vectors to option A, so you can
# switch between A and C later). EMBEDDER_PROVIDER=cloudflare plus an account id and an API token
# with "Workers AI: Read". Remove "local-embedder" from COMPOSE_PROFILES.
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_EMBED_MODEL=@cf/qwen/qwen3-embedding-0.6b
# Choose the embeddings before the first conversation is saved: changing the model later means
# the stored vectors no longer match (search quality drops until the memory is rebuilt).

# --- Sign in with Google / Microsoft (optional) ----------------------------------------------------
# Redirect URI to register with the provider: <HUB_PUBLIC_URL>/v1/auth/oauth/callback
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=
HUB_MICROSOFT_CLIENT_ID=
HUB_MICROSOFT_CLIENT_SECRET=
# common (any account), organizations, or your tenant id.
HUB_MICROSOFT_TENANT=

# --- Passkeys (optional; defaults come from HUB_PUBLIC_URL) ----------------------------------------
# Relying party id: the host of HUB_PUBLIC_URL or a parent domain. Changing it later makes existing
# passkeys unusable.
HUB_WEBAUTHN_RP_ID=
HUB_WEBAUTHN_RP_NAME=
# Only when the hub's pages are served from another origin than HUB_PUBLIC_URL.
HUB_WEBAUTHN_ORIGIN=

# --- Network and limits ----------------------------------------------------------------------------
# Header that carries the visitor's address when every request comes through your proxy:
# x-real-ip with the bundled Caddy, cf-connecting-ip behind Cloudflare. Empty = the TCP peer.
HUB_CLIENT_IP_HEADER=
# Proxy address(es) whose X-Forwarded-For the memory audit log trusts. Empty = the TCP peer.
AUDIT_TRUSTED_PROXIES=
# Changes per person per minute (5x that per address) before the hub answers 429. Default 120.
HUB_WRITE_LIMIT_PER_MINUTE=
# Storage for client approval links, MB per company. Default 1024.
HUB_APPROVALS_COMPANY_MB=
# 1 = a company's SIEM webhook may use http or private addresses (LAN). Default: https, public only.
HUB_SIEM_ALLOW_PRIVATE=
# Optional URL that also receives the daily audit-log anchor (JSON POST).
HUB_AUDIT_ANCHOR_URL=
# Comma-separated e-mails of community library reviewers (bootstrap; managed in the admin later).
HUB_LIBRARY_REVIEWERS=

# --- Memory quotas per company (0 = unlimited) -----------------------------------------------------
QUOTA_EPISODES_PER_DAY=500
QUOTA_INGEST_TOKENS_PER_MONTH=30000000
QUOTA_SEARCHES_PER_MINUTE=120
QUOTA_PERSON_EPISODES_PER_DAY=100
QUOTA_PERSON_INGEST_TOKENS_PER_MONTH=3000000
QUOTA_PERSON_SEARCHES_PER_MINUTE=60
# Optional: receives a JSON POST when a company crosses 80% / 100% of its monthly token quota.
QUOTA_ALERT_WEBHOOK_URL=
# json, or subject-body ({"subject","body"}).
QUOTA_ALERT_WEBHOOK_FORMAT=json

# --- Resources: about 3 GB RAM in use without the local embedder, about 6.5 GB with it -----------
HUB_MEM_LIMIT=512m
MEMORY_MEM_LIMIT=768m
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
NEO4J_MEM_LIMIT=1536m
# How long Neo4j keeps transaction logs (they hold old values of changed or deleted facts).
NEO4J_TX_LOG_RETENTION=2 days
EMBEDDER_MEM_LIMIT=4g
EMBEDDER_THREADS=4
EMBEDDER_MAX_BATCH_TOKENS=512
# Name prefix of the containers and volumes; change it only to run two stacks on one machine.
COMPOSE_PROJECT_NAME=zenstaff
